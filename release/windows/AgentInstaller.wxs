<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Open Security Platform Agent" Manufacturer="Open Security Platform" Version="$(Version)" ProductCode="2F84CC5C-68B5-4CE0-A03B-60A4D38AD100" UpgradeCode="6DB7CBDA-8B6E-4A27-AC18-5E45526E7BB6" Scope="perMachine" Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer Open Security Platform Agent is already installed." AllowSameVersionUpgrades="no" />
    <MediaTemplate EmbedCab="yes" />
    <Property Id="MSIRESTARTMANAGERCONTROL" Value="Disable" />
    <Property Id="ARPSYSTEMCOMPONENT" Value="0" />
    <Launch Condition="VersionNT64 &gt;= 603" Message="Open Security Platform Agent requires a supported 64-bit Windows 10/11 or Windows Server system." />
    <Launch Condition="Privileged" Message="Administrator privileges are required." />
    <Launch Condition="NOT Installed OR NOT REMOVE OR MAINTENANCEAUTHORIZED = &quot;1&quot;" Message="Authorized uninstall requires MAINTENANCEAUTHORIZED=1 from an approved maintenance workflow." />
    <CustomAction Id="BlockUnauthorizedUninstall" Error="Authorized uninstall requires MAINTENANCEAUTHORIZED=1 from an approved maintenance workflow." />
    <CustomAction Id="AuthorizedUninstallCleanup" FileRef="AgentExecutable" ExeCommand="--authorized-uninstall-cleanup" Execute="deferred" Impersonate="no" Return="check" />
    <InstallExecuteSequence>
      <Custom Action="BlockUnauthorizedUninstall" Before="InstallInitialize" Condition="REMOVE~=&quot;ALL&quot; AND MAINTENANCEAUTHORIZED&lt;&gt;&quot;1&quot;" />
      <Custom Action="AuthorizedUninstallCleanup" Before="RemoveFiles" Condition="REMOVE~=&quot;ALL&quot; AND MAINTENANCEAUTHORIZED=&quot;1&quot;" />
    </InstallExecuteSequence>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Open Security Platform">
        <Directory Id="AGENTFOLDER" Name="Agent" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="PLATFORMDATA" Name="OpenSecurityPlatform">
        <Directory Id="AGENTDATA" Name="Agent" />
      </Directory>
    </StandardDirectory>

    <Feature Id="AgentFeature" Title="Open Security Platform Agent" Level="1">
      <ComponentGroupRef Id="AgentPayload" />
      <ComponentRef Id="AgentService" />
      <ComponentRef Id="AgentDataDirectory" />
    </Feature>

    <ComponentGroup Id="AgentPayload" Directory="AGENTFOLDER">
      <Files Include="$(Payload)\*.dll;$(Payload)\*.json;$(Payload)\createdump.exe" />
    </ComponentGroup>
    <Component Id="AgentService" Directory="AGENTFOLDER" Guid="A5160108-F3F9-4B87-B0E9-E3274DFE7A1A" Bitness="always64">
      <File Id="AgentExecutable" Source="$(Payload)\Platform.Agent.exe" KeyPath="yes" />
      <ServiceInstall Id="InstallAgentService" Name="OpenSecurityPlatformAgent" DisplayName="Open Security Platform Agent" Description="Windows endpoint telemetry and response agent" Start="auto" Type="ownProcess" ErrorControl="normal" Account="LocalSystem" />
      <ServiceControl Id="ControlAgentService" Name="OpenSecurityPlatformAgent" Start="install" Stop="both" Remove="uninstall" Wait="yes" />
      <RegistryKey Root="HKLM" Key="SYSTEM\CurrentControlSet\Services\OpenSecurityPlatformAgent">
        <RegistryValue Name="Environment" Type="multiString" Value="PLATFORM_AGENT_CONFIG=[CommonAppDataFolder]OpenSecurityPlatform\Agent\agent-config.json" />
      </RegistryKey>
    </Component>
    <Component Id="AgentDataDirectory" Directory="AGENTDATA" Guid="4D5FFDE7-E0F0-48B9-A639-8D1D49C5C6C3" Bitness="always64" Permanent="yes">
      <CreateFolder>
        <Permission User="SYSTEM" GenericAll="yes" />
        <Permission User="Administrators" GenericAll="yes" />
      </CreateFolder>
      <RegistryValue Root="HKLM" Key="Software\OpenSecurityPlatform\Agent" Name="Version" Type="string" Value="$(Version)" KeyPath="yes" />
    </Component>
  </Package>
</Wix>
